{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "excludeFiles": "{tests,docs,.agents,.claude,.keel,.github}/{**,**/.*,**/.*/**,**/.*/**/.*}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
