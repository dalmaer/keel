{
  "name": "Keel",
  "tagline": "The mothership: start projects the isocan/ledger way, keep them current, and carry their lessons home.",
  "repo": "dalmaer/keel",
  "inbox": "dalmaer/keel-inbox",
  "keel": "self",
  "stack": [
    "node",
    "github-actions"
  ],
  "practice": "0.8.27",
  "practices": [
    "base",
    "agents-md",
    "phases",
    "evidence",
    "lessons",
    "conduct",
    "ci",
    "night",
    "claude",
    "renovate",
    "reconciliation",
    "climb",
    "cross-review"
  ],
  "agents": {
    "claude": {},
    "codex": {}
  },
  "crossReview": {
    "for": [
      "claude/",
      "codex/"
    ]
  },
  "climb": {
    "jobs": [
      "test-time"
    ],
    "budget": {
      "minutes": 45
    },
    "schedule": "nightly"
  },
  "tests": {
    "stalls": [
      "tests/climb.test.mjs",
      "tests/climb-codex.test.mjs",
      "tests/climb-guard.test.mjs",
      "tests/climb-hygiene.test.mjs",
      "tests/climb-pick.test.mjs",
      "tests/climb-tend.test.mjs"
    ]
  },
  "tend": {
    "schedule": "weekly",
    "budget": {
      "minutes": 30
    }
  },
  "ci": {
    "gateWorkflow": "check.yml"
  }
}
