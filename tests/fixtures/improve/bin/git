#!/usr/bin/env node
// A git for keel improve --selftest: the fixture lives inside keel's own repo,
// so a real git would read keel's history. Answers the calls improve makes.
// Synthetic: main has commits on the two days before today (no changelog page
// for either), and every file was last committed on 2020-01-06.
const argv = process.argv.slice(2);
const day = n => new Date(Date.now() - n * 86_400_000).toISOString().slice(0, 10);
if (argv[0] === 'rev-parse') console.log(argv.includes('--git-dir') ? '.git' : '0000000000000000000000000000000000000000');
else if (argv[0] === 'log' && argv.includes('-1')) console.log('2020-01-06');
else if (argv[0] === 'log') console.log([day(1), day(1), day(2)].join('\n'));
else { console.error(`stub git: unknown ${argv.join(' ')}`); process.exit(1); }
